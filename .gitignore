# Secrets - never commit these
.env
*.key
*.pem
*.crt

# AdGuard runtime data
adguard/confdir/
adguard/workdir/

# Snippetbox data
snippetbox/app/

# Homer generated assets (keep config.yml but ignore downloaded icons etc)
homer/assets/icons/
homer/assets/tools/
homer/assets/manifest.json
homer/assets/themes/

# Grafana & Prometheus persistent data
monitoring/grafana/data/
monitoring/prometheus/data/

# Home Assistant — ignore runtime config except hand-editable IaC
homeassistant/config/*
homeassistant/config/www/*
!homeassistant/config/configuration.yaml
!homeassistant/config/automations.yaml
!homeassistant/config/scripts.yaml
!homeassistant/config/scenes.yaml
!homeassistant/config/rest.yaml
!homeassistant/config/themes/
!homeassistant/config/blueprints/

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db
